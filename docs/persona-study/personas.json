          "want": "result: Final Energy|Electricity, World",
          "expect": {
            "kind": "result",
            "has": ["final energy|electricity", "world"]
          }
        },
        {
          "text": "solar capasity china",
          "want": "result: Capacity|Electricity|Solar, China",
          "expect": {
            "kind": "result",
            "has": ["capacity|electricity|solar", "chn"]
          }
        },
        {
          "text": "wat is a carbon budjet",
          "want": "answer: Carbon budget",
          "expect": {
            "kind": "answer",
            "has": ["carbon budget"]
          }
        }
      ]
    },
    {
      "id": "net-zero-analyst",
      "who": "Think-tank analyst following the EU's net-zero pathway",
      "turns": [
        {
          "text": "net zero CO2 emissions in the EU in the net zero study",
          "want": "result: study net-zero, Emissions|CO2, EU",
          "expect": {
            "kind": "result",
            "has": ["net-zero", "emissions|co2\""]
          }
        },
        {
          "text": "what scenarios are in this study?",
          "want": "list the study's scenarios or offer a scenario choice",
          "expect": {
            "kind": "answer",
            "has": ["scenarios in"]
          }
        },
        {
          "text": "what's the remaining carbon budget?",
          "want": "answer: Carbon budget",
          "expect": {
            "kind": "answer",
            "has": ["carbon budget"]
          }
        },
        {
          "text": "hydrogen production in the EU",
          "want": "result: Secondary Energy|Hydrogen, EU",
          "expect": {
            "kind": "result",
            "has": ["secondary energy|hydrogen"]
          }
        },
        {
          "text": "where can I read the policy questions of the Where is the EU headed study?",
          "want": "navigation: that study's policy questions page",
          "expect": {
            "kind": "navigation",
            "has": ["where-is-the-eu-headed"]
          }
        },
        {
          "text": "show me the post-glasgow study page",
          "want": "navigation: Post-Glasgow targets page",
          "expect": {
            "kind": "navigation",
            "has": ["paris-reinforce/post-glasgow"]
          }
        }
      ]
    },
    {
      "id": "city-energy-officer",
      "who": "Energy officer at a Dutch city looking at citizen energy and heat pumps",
      "turns": [
        {
          "text": "I work for the city of Rotterdam on energy communities and heat pumps",
          "want": "studies: region Netherlands, tags citizens / heat pumps",
          "expect": {
            "kind": "studies",
            "has": ["netherlands"]
          }
        },
        {
          "text": "data stories about policies",
          "want": "navigation: Data Stories or the Policy Catalogue story",
          "expect": {
            "kind": "navigation",
            "has": [],
            "any": ["data stories", "policy catalogue"]
          }
        },
        {
          "text": "Is there a policy database I can search?",
          "want": "navigation: Policy Catalogue Interactive Explorer (or apps)",
          "expect": {
            "kind": "navigation",
            "has": ["policy catalogue"]
          }
        },
        {
          "text": "heat pumps in buildings in the EU",
          "want": "result: a buildings heat-pump or final energy variable, EU, or ask",
