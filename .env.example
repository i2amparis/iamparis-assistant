# Classifier: auto = hosted Jev when TYPESAFE_API_KEY is set, otherwise Ollama.
# Also: typesafe | ollama | local (local-jev) | manual
IAM_CLASSIFIER_PROVIDER=auto
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Local Qwen through Ollama: `ollama pull qwen3:4b`
OLLAMA_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434
IAM_RESULTS_URL=https://api.iamparis.eu
PORT=8788
# Browser origins allowed to call the API (the IAMPARIS frontend dev server by default).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# Local app only; put authentication in front before any remote deployment.
DATABASE_PATH=../../data/conversations.db
